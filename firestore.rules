rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may only read/write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Per-article interaction state (likes, dislikes, saves) lives under the
      // same user-owned document, so the same auth check applies to the
      // subcollection queries used to load the feed state.
      match /interactions/{articleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}